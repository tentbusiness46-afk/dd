# Turso database. Get these with:  turso db show <name> --url   and   turso db tokens create <name>
# If these are empty or Turso can't be reached, the app uses a local file (local.db) instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# LOCAL_DB_FILE=local.db

# Long random string used to sign logins
JWT_SECRET=

# Created automatically on first start if no super admin exists
SUPERADMIN_NAME=Super Admin
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=

# Optional
# CORS_ORIGINS=https://localhost,capacitor://localhost
# TZ_OFFSET=+05:30
